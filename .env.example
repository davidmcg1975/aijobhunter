# ---------------------------------------------------------------------------
# AI Contract Hunter - server environment
#
# Every value here is server-side only. Nothing in this file is exposed to the
# browser: there are no NEXT_PUBLIC_ variables by design, because the Adzuna
# and Anthropic credentials must never reach client JavaScript.
#
# Copy to .env and fill in.
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
# Two options.
#
# 1. Embedded (no install, no account) - real PostgreSQL compiled to
#    WebAssembly, running in-process and persisted to a local folder.
#    Run "npm run db:local" once to create the schema.
DATABASE_URL="file:./.pglite"
#
# 2. A real server - Neon, Supabase, or any PostgreSQL 14+.
#    Required for deployment. Use "npm run db:push" instead of db:local.
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
#
#    On Neon, set BOTH of these. The app uses the POOLED endpoint (the one
#    with "-pooler" in the host); migrations must use the DIRECT one, because
#    a pooler in transaction mode cannot hold the session state and advisory
#    locks that DDL needs.
#
#    Keep "&channel_binding=require" on DATABASE_URL, but REMOVE it from
#    DATABASE_URL_DIRECT. node-postgres negotiates channel binding fine, but
#    Prisma's Rust migration engine cannot, and fails with a misleading
#    "Can't reach database server" (P1001) when it is present - the database
#    is reachable, the handshake just never completes.
# DATABASE_URL_DIRECT="postgresql://user:password@host/dbname?sslmode=require"

# --- Sessions (required) ---------------------------------------------------
# At least 32 characters. Also encrypts users' saved API keys, so changing it
# means they must enter those again. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# Public URL of this deployment. Used to build links in emails, and sent as the
# Referer header Careerjet requires.
APP_URL="http://localhost:3000"

# --- Who may create an account (required once reachable from the internet) --
# Comma-separated. Leave empty ONLY while the app is not publicly reachable:
# empty means anyone who finds the URL can register and upload a CV.
ALLOWED_SIGNUP_EMAILS=""

# --- API keys ---------------------------------------------------------------
# Every key below is optional here: each user can enter their own under
# Settings -> API keys in the app, where they are stored encrypted. Keys set
# in this file are the installation's defaults, used by anyone who has not
# entered their own, and by background jobs.

# --- Adzuna (job search) -----------------------------------------------------
# Register at https://developer.adzuna.com/
#
# IMPORTANT - read docs/adzuna.md before opening this up to other people.
# The free allowance is intended for personal research (25/min, 250/day,
# 1000/week, 2500/month). Running a multi-user service on it is a licensing
# question, not a technical one. Set ADZUNA_LICENCE_MODE=licensed only once
# you have written confirmation from Adzuna.
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
ADZUNA_COUNTRY="gb"
ADZUNA_DAILY_CALL_LIMIT="200"
ADZUNA_LICENCE_MODE="personal"

# --- Reed (optional second job source) -------------------------------------
# Free key from https://www.reed.co.uk/developers - a documented public API,
# unlike JobServe. See docs/job-sources.md.
REED_API_KEY=""

# --- Careerjet (optional aggregator source) ---------------------------------
# Publisher key from https://www.careerjet.com/partners/api/
# Aggregates many UK boards and filters on contract type natively.
CAREERJET_API_KEY=""
CAREERJET_LOCALE="en_GB"

# --- AI (analysis, CV reading, tailoring) ------------------------------------
# Two providers; each user picks one under Settings -> AI provider.
#
# Claude - https://console.anthropic.com/
ANTHROPIC_API_KEY=""
AI_MODEL_ANALYSIS="claude-sonnet-5"
AI_MODEL_WRITING="claude-opus-5"
#
# ChatGPT - https://platform.openai.com/api-keys
# (An API key, billed per use - separate from a ChatGPT Plus subscription.)
OPENAI_API_KEY=""
OPENAI_MODEL_ANALYSIS="gpt-5.6-terra"
OPENAI_MODEL_WRITING="gpt-5.6-sol"
#
# Monthly spending cap in pence, across both providers, for the keys in this
# file. Users' own keys are not counted. AI calls stop when this is reached.
AI_MONTHLY_BUDGET_PENCE="50000"

# --- File storage ----------------------------------------------------------
# "local" writes to STORAGE_LOCAL_DIR - fine for development and a single
# server, but not for Vercel, where the filesystem is ephemeral.
# "vercel-blob" requires BLOB_READ_WRITE_TOKEN.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
BLOB_READ_WRITE_TOKEN=""

# --- Email (optional) ------------------------------------------------------
# Without this, verification and reset links are printed to the server log.
SMTP_URL=""
EMAIL_FROM="AI Contract Hunter <noreply@example.com>"

# --- Scheduled jobs (optional) ---------------------------------------------
# Shared secret required by /api/cron/* endpoints.
CRON_SECRET=""
